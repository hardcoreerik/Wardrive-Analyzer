# ESP-IDF build output and component-manager-fetched dependencies --
# regenerated from CMakeLists.txt/idf_component.yml + dependencies.lock,
# not source.
build/
managed_components/

# Generated from sdkconfig.defaults by `idf.py reconfigure`/`build`; the
# defaults file is the source of truth, not this derived, machine/build-
# specific expansion of it.
sdkconfig
sdkconfig.old

# Claude Code session directory.
.claude/

# PlatformIO is not used for this board (see project_truth.md) --
# .pio/.pio-venv above are the leftover toolchain dirs, gitignored so
# they can't slip back in; these two are the specific config/generated
# files a `pio run` would recreate if PlatformIO were used again. If
# either of these reappears, that's a sign PlatformIO got invoked by
# mistake, not something to commit.
platformio.ini
sdkconfig.m5tab5_espidf
